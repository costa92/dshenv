# Machine-local dshenv state must not leak into the image: the build applies only the manifest.
.git
envctl/state.json
envctl/overlay-selection.json
envctl/dshenv.lock
envctl/dshenv.lock.*
envctl/backups
envctl/logs
envctl/trash
envctl/sources
# web start records hold the live dsh web login URL, token included.
envctl/run
# A subscription and its team clone belong to the machine that subscribed.
envctl/remote.json
envctl/remote
